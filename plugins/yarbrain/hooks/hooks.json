{
  "description": "Print Yarbrain lesson counts at session start, and let only the Yarbrain gate agent judge lessons in Claude Code.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "YARBRAIN_NO_DOWNLOAD=1 \"${CLAUDE_PLUGIN_ROOT}/bin/yarbrain\" hook session-start --contract 1",
            "commandWindows": "(where yarbrain >nul 2>nul || exit /b 0) && yarbrain hook session-start --contract 1",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "YARBRAIN_NO_DOWNLOAD=1 \"${CLAUDE_PLUGIN_ROOT}/bin/yarbrain\" hook pre-tool-use --contract 1",
            "commandWindows": "(where yarbrain >nul 2>nul || exit /b 0) && yarbrain hook pre-tool-use --contract 1",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
